# AgentCore Runtime deployment config.
#
# The real file is `.bedrock_agentcore.yaml`, generated by `agentcore configure`
# and updated by `agentcore launch`. Do not hand-maintain it — this example exists
# to document the fields and to record the values this project expects.
#
#   cp .bedrock_agentcore.yaml.example .bedrock_agentcore.yaml   # then edit
#   agentcore configure --entrypoint app.py --name sql_test_generator
#
# The generated file records your account ID and runtime ARN, so it is gitignored.

default_agent: sql_test_generator

agents:
  sql_test_generator:
    name: sql_test_generator

    # Module exposing the BedrockAgentCoreApp instance (see AGENTCORE_BLUEPRINT.md §3).
    entrypoint: app.py

    # AgentCore Runtime only accepts arm64 images.
    platform: linux/arm64
    container_runtime: docker

    aws:
      region: eu-central-1
      account: "<ACCOUNT_ID>"

      # Trusts bedrock-agentcore.amazonaws.com. Needs bedrock:InvokeModel,
      # ECR pull, and CloudWatch Logs write. See AGENTCORE_BLUEPRINT.md §4.
      execution_role: arn:aws:iam::<ACCOUNT_ID>:role/AgentCoreExecutionRole
      execution_role_auto_create: false

      ecr_repository: <ACCOUNT_ID>.dkr.ecr.eu-central-1.amazonaws.com/sql-test-generator
      ecr_auto_create: true

      network_configuration:
        network_mode: PUBLIC

      protocol_configuration:
        # Plain request/response. The SDK serves POST /invocations and GET /ping
        # on port 8080. Use MCP only if exposing this as a tool server.
        server_protocol: HTTP

      observability:
        enabled: true

    # Injected into the container. BEDROCK_MODEL_ID is required — llm_client.py
    # raises at startup without it.
    environment:
      BEDROCK_MODEL_ID: eu.amazon.nova-pro-v1:0
      AWS_REGION: eu-central-1
      LOG_LEVEL: INFO

    # SigV4 by default. Uncomment to accept OAuth 2.0 bearer tokens instead.
    # authorizer_configuration:
    #   customJWTAuthorizer:
    #     discoveryUrl: https://<IDP_DOMAIN>/.well-known/openid-configuration
    #     allowedClients:
    #       - <CLIENT_ID>

    # Populated by `agentcore launch`. Leave empty when creating by hand.
    bedrock_agentcore:
      agent_id: ""
      agent_arn: ""
